# Keep training and private-test data local or in a private Kaggle Dataset.
# The supplied labeled open sets are bundled for reproducible evaluation.
/data/*
!/data/open_validation/
/data/open_validation/*
!/data/open_validation/task_b_open_test_translated_labeled.csv
!/data/open_validation/task_a_open_test_translated_labeled.csv
/kaggle_data/

# Training artifacts are large and can contain competition predictions.
/checkpoints/
/outputs/
/wandb/
*.zip
*.pt
*.pth
*.safetensors
/logs/
/runs/
/.cache/
/tmp/

# Local research/slide artifacts, not part of the training repository.
/.tmp_llm_slide/
/Viper_HASTIKA_BERT_LLM.pptx
/Viper_HASTIKA_BERT_LLM.pptx.inspect.ndjson

# Python caches, environments, notebooks and editor settings.
__pycache__/
*.py[cod]
.venv/
.env
.ipynb_checkpoints/
.ruff_cache/
.pytest_cache/
.idea/
.vscode/

# Operating-system files.
.DS_Store
Thumbs.db
